# StarVid 环境变量（Vite 原生支持）
# 以 VITE_ 开头：暴露到浏览器端（import.meta.env.VITE_xxx）；其余仅服务端读取，不进打包产物。
# 修改后需重启 dev / 重新 build 才生效。

# 资源站 API 代理前缀（开发环境用，与 vite.config.js 的 proxyMiddleware、nginx 的 /proxy/ 一致）
VITE_PROXY_URL=/proxy/

# 代理模式：开发走 /proxy/ 中间件，生产走本项目 e 云函数 /e/（见 edge-functions/e）
# 默认按环境自动判断（dev=proxy，build/preview=function）；如需强制可填 'proxy' 或 'function'
# VITE_PROXY_MODE=function

# 生产环境云函数路径（浏览器端拼接用），与 edge-functions/e 的 /e/ 一致
VITE_FUNC_URL=/e/

# 腾讯云 CDN 通用代理前缀（复刻 mtv 的 proxy.worker.js「全局代理」，托管在腾讯云）。
# 形如 https://your-cdn-proxy.example.com/ ，目标地址 encodeURIComponent 拼接到其后。
# 配置后资源站搜索/详情、视频流默认走此代理，不再依赖自建云函数；留空则回退云函数 /e/（生产）或本地 /proxy/（开发）。
# 注意：该代理仅做「路径编码 + 服务端转发」，不做 m3u8 改写。
VITE_CDN_PROXY_URL=

# Vite dev / preview 服务端口（仅服务端使用）
DEV_PORT=5173

# Vite 部署基础路径（仅服务端使用）；部署到子路径时改成 /starvid/ 等，根路径用 /
BASE=/

# 资源站 API 代理请求的 User-Agent（浏览器端与代理后端共用）
VITE_PROXY_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

# 资源站 API 请求超时（毫秒，浏览器端）
VITE_API_TIMEOUT=15000

# 豆瓣接口请求超时（毫秒，浏览器端）
VITE_DOUBAN_TIMEOUT=10000

# 资源站代理后端端口（仅 Node 后端使用；对应 nginx.conf 的 proxy_pass 端口）
PROXY_PORT=8787
